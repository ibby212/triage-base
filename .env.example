# Copy to .env.local and fill in. Never commit .env.local.

# Main LLM configuration ("default" in the model menu). Any OpenAI-compatible endpoint.
# Example: Gemini through its OpenAI-compatible endpoint.
LLM_LABEL=Gemini 3.1 Flash Lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite-preview
# json_schema (provider enforces the schema) or prompt (format described in the prompt only).
# Zod checks the answer in both modes.
LLM_STRUCTURED_OUTPUT=json_schema
# Prices in USD per million tokens, used for the cost columns. 0 for free tiers.
LLM_PRICE_INPUT_PER_M=0.10
LLM_PRICE_OUTPUT_PER_M=0.40
# Requests per minute allowed by the provider (free tier). The smoke test paces itself. 0 = no limit.
LLM_MAX_RPM=14

# Optional second LLM configuration ("alt" in the model menu), for model comparison (F5).
LLM_ALT_LABEL=NVIDIA gpt-oss-20b
LLM_ALT_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_ALT_API_KEY=
LLM_ALT_MODEL=openai/gpt-oss-20b
LLM_ALT_STRUCTURED_OUTPUT=prompt
LLM_ALT_PRICE_INPUT_PER_M=0
LLM_ALT_PRICE_OUTPUT_PER_M=0
LLM_ALT_MAX_RPM=35
